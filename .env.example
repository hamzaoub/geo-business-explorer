# OpenStreetMap / Overpass (default, no key for light testing)
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Public fallback is automatic when using the default endpoint.
# Optional override for an alternate operator or dedicated provider:
# OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# To disable public fallback entirely:
# OVERPASS_FALLBACK_URL=none
OVERPASS_CONTACT_EMAIL=your-email@example.com

# Optional Overture worker. Run the Python service first.
# Do NOT expose this key through a NEXT_PUBLIC_ variable.
# OVERTURE_SERVICE_URL=http://127.0.0.1:8787
# OVERTURE_WORKER_KEY=replace-with-a-random-secret

# Optional explicit place search (not autocomplete).
# Requires a real operator contact address for Nominatim public-service compliance.
# GEOCODER_CONTACT_EMAIL=your-email@example.com
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional MapTiler tiles when a commercial map style is added.
# NEXT_PUBLIC_MAPTILER_API_KEY=
